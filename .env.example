# CÍRCULO IA — Variables de entorno para Meta / Vercel
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
META_GRAPH_VERSION=v23.0
CIRCULO_SITE_URL=https://iacirculo.vercel.app/

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Entorno lógico para aislar claves Redis entre Preview y Production.
# En Vercel Preview configurar AXIAL_ENV=preview.
AXIAL_ENV=development

# Autenticación del endpoint /api/internal/messenger-worker.
# Configurar un valor aleatorio desde Vercel; no versionar secretos reales.
CRON_SECRET=
# Alternativa aceptada por el Worker si CRON_SECRET no está definido.
AXIAL_WORKER_SECRET=

# Tiempo mínimo de inactividad para recuperar eventos pendientes abandonados.
AXIAL_STREAM_MIN_IDLE_MS=60000

# Secreto aleatorio de al menos 32 caracteres para seudonimizar destinatarios.
# Mantener privado y configurar también en Vercel.
TELEMETRY_HASH_SECRET=

# Compatibilidad con la nomenclatura anterior del proyecto:
# META_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# META_APP_SECRET=
