# CÍRCULO IA — Meta / Vercel
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
META_GRAPH_VERSION=v23.0
CIRCULO_SITE_URL=https://iacirculo.vercel.app/

# Bandeja de revisión humana (Redis REST compatible con Upstash / Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativas aceptadas: UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN.
REVIEW_API_TOKEN=

# Modos: AUTO (respuesta segura automática), SUPERVISION (borrador para aprobación), MANUAL (sin borrador).
# Valor seguro por defecto: SUPERVISION.
MESSENGER_MODE=SUPERVISION
# El despacho permanece bloqueado salvo habilitación explícita.
DISPATCH_ENABLED=false

# Notificaciones Outlook mediante Microsoft Graph (permisos de aplicación Mail.Send + consentimiento admin).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
OUTLOOK_NOTIFICATION_FROM=
OUTLOOK_NOTIFICATION_TO=circulodelegis@outlook.com

# Compatibilidad con nombres anteriores:
# META_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# META_APP_SECRET=
